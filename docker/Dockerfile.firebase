FROM eclipse-temurin:21-jre-jammy AS java

FROM node:22-bookworm-slim
COPY --from=java /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/opt/java/openjdk/bin:${PATH}"
ENV FIREBASE_EMULATORS_PATH=/opt/firebase/emulators
ENV CI=true
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libfontconfig1 \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g firebase-tools@15.0.0 \
    && firebase setup:emulators:firestore \
    && firebase setup:emulators:ui
WORKDIR /app
COPY docker/firebase.docker.json ./firebase.json
COPY firestore.rules firestore.indexes.json ./
COPY --chmod=755 docker/start-firebase.sh /usr/local/bin/start-firebase
EXPOSE 4000 4400 4500 8081 9099 9150
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/start-firebase"]
